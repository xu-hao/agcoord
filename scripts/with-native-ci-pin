#!/usr/bin/env python3
"""Run a CI rehearsal with a private client pinned to its separately built broker."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))
from agcoord import __version__  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact", type=Path, required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        parser.error("a rehearsal command is required after --")
    with args.artifact.open("rb") as artifact:
        digest = hashlib.file_digest(artifact, "sha256").hexdigest()
    with tempfile.TemporaryDirectory(prefix="agcoord-ci-pin-") as directory:
        private = Path(directory)
        package = private / "agcoord"
        shutil.copytree(
            ROOT / "src/agcoord", package,
            ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
        )
        (package / "native_host_pin.json").write_text(
            json.dumps({"format": 1, "version": __version__, "broker_sha256": digest}) + "\n",
            encoding="utf-8",
        )
        environment = os.environ.copy()
        environment["PYTHONPATH"] = os.pathsep.join(
            path for path in (str(private), environment.get("PYTHONPATH", "")) if path
        )
        return subprocess.run(command, env=environment, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())

{
  "manifest_version": 3,
  "protocols": {
    "rust_native": 5
  },
  "required_domains": [
    "commands",
    "repositories",
    "publication",
    "tui",
    "protocol",
    "resources",
    "receipts",
    "migrations",
    "contention",
    "cancellation",
    "recovery",
    "crash_database",
    "crash_launcher",
    "crash_cgroup",
    "crash_publication",
    "crash_cleanup",
    "crash_replacement",
    "fuzz_clients",
    "fuzz_state",
    "no_duplicate_execution",
    "no_stale_publication",
    "no_unrelated_kill",
    "no_unverified_enforcement"
  ],
  "execution": {
    "rust_build_jobs": 4,
    "python_test_workers": 1,
    "rust_test_threads": 1
  },
  "behaviors": [
    {
      "id": "commands.strict-public-records",
      "domain": "commands",
      "description": "Public submit, snapshot, list, status, and log records retain their strict JSON contract.",
      "tests": {
        "rust_native": [
          "client_compatibility::python_public_commands_keep_the_protocol_five_json_contract"
        ]
      }
    },
    {
      "id": "repositories.lanes-and-capacity",
      "domain": "repositories",
      "description": "A full is ordinary lane work rather than a barrier, and queued lane work packs by declared resources while unrelated repositories share available capacity.",
      "tests": {
        "rust_native": [
          "scheduler::full_is_not_a_lane_barrier_and_lane_work_packs_by_capacity"
        ]
      }
    },
    {
      "id": "repositories.worktree-scoped-land-barrier",
      "domain": "repositories",
      "description": "A land excludes other lands in its repository lane and jobs from its own worktree, while work from other worktrees of the same repository overlaps it when capacity allows.",
      "tests": {
        "rust_native": [
          "scheduler::land_barrier_excludes_only_lane_work_in_its_own_worktree"
        ]
      }
    },
    {
      "id": "publication.one-atomic-land",
      "domain": "publication",
      "description": "A land request may durably synchronize its exact head during preflight, then holds one barrier through its gate and publication authority transition.",
      "tests": {
        "rust_native": [
          "client_compatibility::atomic_land_keeps_gate_and_publication_inside_one_native_admission"
        ]
      }
    },
    {
      "id": "publication.land-request-options",
      "domain": "publication",
      "description": "A land request's target-sync opt-out and per-request avoided commits reach the land worker as arguments, an invalid setting is refused at submission, and the coordinator-reserved environment names never reach a worker.",
      "tests": {
        "rust_native": [
          "scheduler::land_request_options_reach_the_worker_as_arguments"
        ]
      }
    },
    {
      "id": "publication.land-failure-reasons",
      "domain": "publication",
      "description": "A failed land records its documented failure reason: gate-failed for a red gate and otherwise the stable code of the land worker's reported exit status, with merge-error for an unknown status.",
      "tests": {
        "rust_native": [
          "scheduler::failed_lands_record_their_documented_failure_reason"
        ]
      }
    },
    {
      "id": "tui.real-snapshot-refresh",
      "domain": "tui",
      "description": "The real Textual application renders public queue identity and refreshes a live native snapshot.",
      "tests": {
        "rust_native": [
          "client_compatibility::real_textual_refresh_renders_a_protocol_five_snapshot"
        ]
      }
    },
    {
      "id": "protocol.explicit-version-boundary",
      "domain": "protocol",
      "description": "Legacy state is never treated as current state or silently credited with enforcement evidence.",
      "tests": {
        "rust_native": [
          "scheduler::every_legacy_protocol_migrates_through_protocol_four_without_inventing_evidence"
        ]
      }
    },
    {
      "id": "resources.typed-lifecycle",
      "domain": "resources",
      "description": "Typed resources prepare before release, measure terminal use, and clean only owned state.",
      "tests": {
        "rust_native": [
          "scheduler::typed_cgroup_fixture_applies_controls_before_release_and_cleans_owned_leaf"
        ]
      }
    },
    {
      "id": "resources.zero-scratch-default",
      "domain": "resources",
      "description": "Jobs without a scratch provider inherit no temporary-directory variables and receive no managed run scratch path.",
      "tests": {
        "rust_native": [
          "scheduler::workers_without_scratch_resources_do_not_inherit_caller_temp_paths"
        ]
      }
    },
    {
      "id": "resources.scratch-policy-admission",
      "domain": "resources",
      "description": "A full or land worker that declared a scratch policy verifies its admission with its own PID, although the recorded worker is the coordinator's launcher.",
      "tests": {
        "rust_native": [
          "scheduler::full_worker_under_a_tmpfs_policy_verifies_its_admission"
        ]
      }
    },
    {
      "id": "receipts.verified-terminal-evidence",
      "domain": "receipts",
      "description": "Receipts retain sanitized applied, peak, and event evidence exactly once.",
      "tests": {
        "rust_native": [
          "scheduler::cgroup_fixture_reports_conservative_compute_and_memory_peaks_and_events"
        ]
      }
    },
    {
      "id": "migrations.rollback-freshness",
      "domain": "migrations",
      "description": "Migration and rollback preserve history while invalidating stale pre-rollback gates.",
      "tests": {
        "rust_native": [
          "scheduler::migration_and_rollback_preserve_history_and_reject_stale_gates",
          "scheduler::every_legacy_protocol_migrates_through_protocol_four_without_inventing_evidence",
          "scheduler::each_migration_cycle_uses_a_fresh_protocol_four_rollback_baseline"
        ]
      }
    },
    {
      "id": "contention.owner-and-timeout",
      "domain": "contention",
      "description": "Database contention honors the configured timeout without replacing or cancelling the live owner.",
      "tests": {
        "rust_native": [
          "scheduler::transient_database_contention_keeps_the_same_owner_and_honors_timeout"
        ]
      }
    },
    {
      "id": "contention.durable-maintenance-drain",
      "domain": "contention",
      "description": "Drain linearizes with submissions, preserves accepted work and authoritative publication, survives owner replacement, and resumes only by exact receipt.",
      "tests": {
        "rust_native": [
          "client_compatibility::durable_drain_rejects_native_submissions_then_resumes_by_exact_id",
          "client_compatibility::draining_native_spool_recovers_after_broker_crash"
        ]
      }
    },
    {
      "id": "cancellation.complete-process-tree",
      "domain": "cancellation",
      "description": "Cancellation drains the complete owned process tree before publishing a terminal result.",
      "tests": {
        "rust_native": [
          "scheduler::cancellation_drains_the_complete_owned_process_group_before_terminal_state"
        ]
      }
    },
    {
      "id": "recovery.adopt-without-duplicate",
      "domain": "recovery",
      "description": "A replacement owner adopts live work and its enforcement handle without duplicate execution.",
      "tests": {
        "rust_native": [
          "scheduler::replacement_adopts_a_live_worker_without_duplicate_execution"
        ]
      }
    },
    {
      "id": "crash.database-transactions",
      "domain": "crash_database",
      "description": "Ownership and admission transaction crashes recover without orphaning or duplicating work.",
      "tests": {
        "rust_native": [
          "scheduler::ownership_and_admission_commit_crashes_recover_without_duplicate_work"
        ]
      }
    },
    {
      "id": "crash.launcher-release",
      "domain": "crash_launcher",
      "description": "Launcher setup and final release crashes never expose user code before durable ownership.",
      "tests": {
        "rust_native": [
          "scheduler::setup_and_final_release_crashes_preserve_exactly_once_execution"
        ]
      }
    },
    {
      "id": "crash.cgroup-attachment",
      "domain": "crash_cgroup",
      "description": "A durable cgroup handle survives replacement and cleanup targets only the recorded leaf.",
      "tests": {
        "rust_native": [
          "scheduler::replacement_recovers_a_live_cgroup_worker_and_cleans_its_durable_leaf"
        ]
      }
    },
    {
      "id": "crash.publication-authority",
      "domain": "crash_publication",
      "description": "Owner replacement cannot rerun a gate or advance publication with a dead or stale worker identity.",
      "tests": {
        "rust_native": [
          "scheduler::a_dead_land_worker_identity_cannot_advance_publication"
        ]
      }
    },
    {
      "id": "crash.terminal-cleanup",
      "domain": "crash_cleanup",
      "description": "Terminal cleanup is durable, retryable, and reclaims only test-owned trees.",
      "tests": {
        "rust_native": [
          "scheduler::worker_identity_and_terminal_commit_crashes_recover_durably"
        ]
      }
    },
    {
      "id": "crash.replacement-owner",
      "domain": "crash_replacement",
      "description": "A replacement owner preserves the one live worker and one allocation until terminal recovery.",
      "tests": {
        "rust_native": [
          "scheduler::replacement_adopts_a_live_worker_without_duplicate_execution"
        ]
      }
    },
    {
      "id": "fuzz.clients-invalid-corpus",
      "domain": "fuzz_clients",
      "description": "A property corpus of invalid resource and client values is refused without accepting a row.",
      "tests": {
        "rust_native": [
          "scheduler::cgroup_fixture_refuses_impossible_and_ambiguous_resource_contracts_stably"
        ]
      }
    },
    {
      "id": "fuzz.stored-state-corpus",
      "domain": "fuzz_state",
      "description": "Malformed schema, rows, receipts, resource state, and NUL-bearing values fail without rewriting stored bytes.",
      "tests": {
        "rust_native": [
          "scheduler::corrupt_schema_or_row_fails_stably_without_rewriting_state",
          "scheduler::corrupt_resource_contract_or_state_fails_before_owner_mutation",
          "scheduler::stored_nul_values_are_rejected_before_worker_syscalls"
        ]
      }
    },
    {
      "id": "safety.no-duplicate-execution",
      "domain": "no_duplicate_execution",
      "description": "Crash recovery never executes the admitted command more than once.",
      "tests": {
        "rust_native": [
          "scheduler::ownership_and_admission_commit_crashes_recover_without_duplicate_work"
        ]
      }
    },
    {
      "id": "safety.no-stale-publication",
      "domain": "no_stale_publication",
      "description": "Remote movement or dead publication identity refuses without mutating a forge reference.",
      "tests": {
        "rust_native": [
          "scheduler::a_dead_land_worker_identity_cannot_advance_publication"
        ]
      }
    },
    {
      "id": "safety.no-unrelated-kill",
      "domain": "no_unrelated_kill",
      "description": "Changed kernel or process identity is refused without killing or removing the replacement.",
      "tests": {
        "rust_native": [
          "scheduler::stale_worker_identity_never_signals_an_unrelated_reused_process_group"
        ]
      }
    },
    {
      "id": "safety.no-unverified-enforcement",
      "domain": "no_unverified_enforcement",
      "description": "Required enforcement refuses before user code when the backend cannot prove application.",
      "tests": {
        "rust_native": [
          "scheduler::required_cgroup_binding_refuses_before_user_code_when_delegation_is_unavailable"
        ]
      }
    }
  ],
  "intentional_differences": [
    {
      "id": "resources.deterministic-kernel-seams",
      "description": "Default conformance uses owned deterministic kernel seams; real cgroup and project-quota tests remain explicit host opt-ins.",
      "rationale": "The ordinary gate must be safe on undelegated hosts without weakening the separate enforced-host proof.",
      "tests": {
        "rust_native": [
          "scheduler::typed_cgroup_fixture_applies_controls_before_release_and_cleans_owned_leaf",
          "scheduler::real_cgroup_cpu_and_pid_limits_cover_the_complete_process_tree"
        ]
      }
    }
  ]
}

  "intentional_differences": [
    {
      "id": "owner.production-eligibility",
      "description": "The Python protocol-4 owner remains a reference fixture; installed clients require the audited protocol-5 Rust owner.",
      "python_reference": "The reference broker is exercised directly by conformance tests and is never an automatic production fallback.",
      "rust_native": "The release executable publishes protocol, implementation, version, build, target, and SQLite identity.",
      "rationale": "Removing interpreter and environment ambiguity requires one production owner while retaining an executable reference oracle.",
      "tests": {
        "python_reference": [
          "tests/test_queue.py::test_first_client_refuses_a_missing_native_broker_without_python_fallback"
        ],
        "rust_native": [
          "identity::reports_exact_version_and_protocol_identity"
        ]
      }
    },
    {
      "id": "resources.deterministic-kernel-seams",
      "description": "Default conformance uses owned deterministic kernel seams; real cgroup and project-quota tests remain explicit host opt-ins.",
      "python_reference": "Python tests inject test-owned cgroup and quota systems behind the public broker boundary.",
      "rust_native": "Native tests select explicit fixture roots, while identically named real tests activate only with dedicated host variables.",
      "rationale": "The ordinary gate must be safe on undelegated hosts without weakening the separate enforced-host proof.",
      "tests": {
        "python_reference": [
          "tests/test_cgroup_compute.py::test_cpu_and_pid_limits_apply_before_user_code_and_report_terminal_usage"
        ],
        "rust_native": [
          "scheduler::typed_cgroup_fixture_applies_controls_before_release_and_cleans_owned_leaf",
          "scheduler::real_cgroup_cpu_and_pid_limits_cover_the_complete_process_tree"
        ]
      }
    }
  ]

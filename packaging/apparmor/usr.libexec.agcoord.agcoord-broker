abi <abi/4.0>,
include <tunables/global>

# Keep ordinary host operations broad while using a real enforcing domain. Ubuntu 24.04's
# AppArmor parser implements default_allow as an unconfined profile, which would neither report
# enforce mode nor apply the explicit denials below.
profile agcoord-broker /usr/libexec/agcoord/agcoord-broker flags=(enforce,attach_disconnected,mediate_deleted) {
  allow capability,
  allow network,
  allow signal,
  allow dbus,
  allow file rwlkm /{,**},
  allow unix,
  allow mqueue,
  allow mount,
  allow umount,
  allow pivot_root,
  allow io_uring,
  allow userns create,
  deny ptrace,

  # A Python client inside admitted work may execute safe broker client verbs, but that new
  # process enters a domain without namespace permission. Every submitted command enters the
  # admitted domain before any of its own code runs.
  /usr/libexec/agcoord/agcoord-broker px -> agcoord-broker-client,
  /** px -> agcoord-admitted,
}

# Calls from admitted work transition here instead of reattaching to the setup profile.
profile agcoord-broker-client flags=(enforce,attach_disconnected,mediate_deleted) {
  allow capability,
  allow network,
  allow signal,
  allow dbus,
  allow file rwlkm /{,**},
  allow unix,
  allow mqueue,
  allow mount,
  allow umount,
  allow pivot_root,
  allow io_uring,
  allow ptrace,
  deny userns,
  deny change_profile -> agcoord-broker,
  deny /proc/@{pid}/attr/{current,exec} w,
  deny /proc/self/attr/{current,exec} w,
  deny /proc/thread-self/attr/{current,exec} w,

  /usr/libexec/agcoord/agcoord-broker px -> agcoord-broker-client,
  /** px -> agcoord-admitted,
}

profile agcoord-admitted flags=(enforce,attach_disconnected,mediate_deleted) {
  allow capability,
  allow network,
  allow signal,
  allow dbus,
  allow file rwlkm /{,**},
  allow unix,
  allow mqueue,
  allow mount,
  allow umount,
  allow pivot_root,
  allow io_uring,
  allow ptrace,
  deny userns,
  deny change_profile -> agcoord-broker,
  deny /proc/@{pid}/attr/{current,exec} w,
  deny /proc/self/attr/{current,exec} w,
  deny /proc/thread-self/attr/{current,exec} w,

  /usr/libexec/agcoord/agcoord-broker px -> agcoord-broker-client,
  /** ix,
}
